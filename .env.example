# Copy this to `.env` and fill in your keys.
# Load it with python-dotenv (pip install python-dotenv) or just set as
# environment variables before running.

# ============ LLM INTERPRETATION (recommended) ============
# OpenAI:           OPENAI_API_KEY=sk-...                 OPENAI_MODEL=gpt-4o-mini
# OpenRouter:       OPENAI_API_KEY=sk-or-...              OPENAI_MODEL=anthropic/claude-3.5-sonnet
#                   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Anthropic direct: requires anthropic SDK (different module). Use OpenRouter for OpenAI-compat.
# Local Ollama:     OPENAI_API_KEY=ollama   OPENAI_MODEL=llama3.1
#                   OPENAI_BASE_URL=http://localhost:11434/v1
# Azure OpenAI:     OPENAI_API_KEY=<azure-key>            OPENAI_MODEL=<deployment-name>
#                   OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=

# ============ DATA SOURCES (optional but boost quality) ============

# FRED — US Treasury yields, DXY, real yields. Highest-impact upgrade.
# Free, instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# CryptoPanic — aggregated crypto news with sentiment.
# Free tier ~200 reqs/day: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Coinglass — derivatives data (liquidations, exchange flows).
# Free tier: https://www.coinglass.com/api
COINGLASS_API_KEY=

# NewsAPI — macro news headlines.
# Free tier 100 reqs/day: https://newsapi.org/register
NEWSAPI_API_KEY=

# LunarCrush — social sentiment momentum (paid only).
LUNARCRUSH_API_KEY=

# ============ ALERTS ============
# Telegram bot for forecast alerts.
# Create bot via @BotFather on Telegram, get your chat_id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
